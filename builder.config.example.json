{
  "repo": {
    "enable": false,
    "url": "https://github.com/username/afilmory-assets"
  },
  "storage": {
    "provider": "s3",
    "bucket": "my-photos",
    "region": "us-east-1",
    "endpoint": "https://s3.amazonaws.com",
    "prefix": "photos/",
    "customDomain": "https://cdn.example.com",
    "excludeRegex": "(?:^|/)raw-backups/"
  },
  "options": {
    "defaultConcurrency": 10,
    "enableLivePhotoDetection": true,
    "showProgress": true,
    "showDetailedStats": true,
    "digestSuffixLength": 0
  },
  "logging": {
    "verbose": false,
    "level": "info",
    "outputToFile": false,
    "logFilePath": "./logs/builder.log"
  },
  "performance": {
    "worker": {
      "workerCount": 8,
      "timeout": 30000,
      "useClusterMode": true,
      "workerConcurrency": 2
    }
  }
}