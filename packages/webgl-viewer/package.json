{
  "name": "@afilmory/webgl-viewer",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.1.2",
  "description": "Afilmory GPU Image Viewer",
  "author": "Innei",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@webgpu/types": "^0.1.74",
    "nbump": "2.1.8",
    "react": "^19.3.0",
    "tsdown": "0.23.1",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
