# Copy this file to .env and fill in the values before running the application.

# GitHub Personal Access Token with cache repo access
GIT_TOKEN=

# S3 Credentials if you are using S3 as storage provider
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# S3 Configuration. These will override `builder.config.json`. Leave empty to use configs from there.
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_PREFIX=
S3_CUSTOM_DOMAIN=
S3_EXCLUDE_REGEX=

# PostgreSQL connection string for interaction status storage
PG_CONNECTION_STRING=
