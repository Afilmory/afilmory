    "Email sign-in is available for invited and App Review accounts. New public accounts use a social provider.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールログインは招待済みアカウントと App Review 用アカウントで利用できます。新規公開アカウントはソーシャルログインを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 로그인은 초대된 계정과 App Review 계정에서 사용할 수 있습니다. 새 공개 계정은 소셜 로그인을 사용합니다."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "電郵登入只供獲邀帳戶及 App Review 審核帳戶使用；新的公開帳戶請使用社交登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱登录仅供受邀账户和 App Review 审核账户使用；新公开账户请使用社交登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件登入僅供受邀帳號及 App Review 審核帳號使用；新的公開帳號請使用社群登入。"
          }
        }
      }
    },
    "Enter a name and a URL identifier of at least two characters.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と 2 文字以上の URL 識別子を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 두 글자 이상의 URL 식별자를 입력하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入名稱，以及至少兩個字元的網址識別碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入名称，以及至少两个字符的网址标识。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入名稱，以及至少兩個字元的網址識別碼。"
          }
        }
      }
    },
    "Enter both email and password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスとパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일과 비밀번호를 입력하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入電郵和密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入邮箱和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入電子郵件和密碼。"
          }
        }
      }
    },
    "Enter comma-separated tags. The result replaces tags on every selected photo.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ区切りでタグを入力してください。選択した各写真のタグが置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분한 태그를 입력하세요. 선택한 모든 사진의 태그가 대체됩니다."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入以逗號分隔的標籤。結果會取代每張所選相片的現有標籤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入以逗号分隔的标签。结果会替换每张所选照片的现有标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
