    "For your security, sign out and sign in again, then delete the account within a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了安全，请先退出登录再重新登录，然后在几分钟内删除账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了安全，請先登出再重新登入，然後在幾分鐘內刪除帳號。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為了安全，請先登出再重新登入，然後在幾分鐘內刪除帳戶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全のため、一度サインアウトして再度サインインし、数分以内にアカウントを削除してください。"
