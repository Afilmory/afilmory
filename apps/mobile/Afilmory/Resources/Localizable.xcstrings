    "By continuing, you agree to Afilmory's Terms of Use and Privacy Policy.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意 Afilmory 的使用条款和隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即表示你同意 Afilmory 的使用條款和隱私權政策。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
