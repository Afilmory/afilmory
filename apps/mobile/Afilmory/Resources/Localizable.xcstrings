    "Pick a few photos you love. Once developed, they hang in your gallery.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑几张你最满意的照片，冲洗完就挂进展厅。"
