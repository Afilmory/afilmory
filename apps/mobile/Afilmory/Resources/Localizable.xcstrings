      }
    },
    "You can use Afilmory without them. Change them anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不给也能用。之后在系统设置里随时打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不給也能用。之後可在系統設定中隨時開啟。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "不給也能用。之後可在系統設定中隨時開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しなくても使えます。あとから設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하지 않아도 쓸 수 있어요. 나중에 설정에서 언제든 바꿀 수 있습니다."
          }
        }
      }
    },
    "Reads the photos you pick, with their EXIF and place, when you develop them. Only the ones you choose.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选片、冲洗时读取照片和它的 EXIF、拍摄地点。只读你选中的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選片、沖洗時讀取照片與其 EXIF、拍攝地點。只讀取你選中的照片。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選相、沖洗時讀取相片及其 EXIF、拍攝地點。只讀取你揀選的相片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現像するときに、選んだ写真と EXIF・撮影地を読み込みます。選んだ写真だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현상할 때 고른 사진과 EXIF, 촬영 장소를 읽습니다. 선택한 사진만 읽어요."
          }
        }
