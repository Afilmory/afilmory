    "Your subscriptions are saved. Enable notifications in Settings to receive new photo updates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読は保存されています。新しい写真の通知を受け取るには、設定で通知をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 저장되어 있습니다. 새 사진 업데이트를 받으려면 설정에서 알림을 켜세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱已經儲存。請在系統設定中開啟通知，以接收新相片更新。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
