    "Choose a solid accent color for highlighted controls.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強調表示に使用する不透明なアクセントカラーを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 컨트롤에 사용할 불투명 강조 색상을 선택합니다."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇用於高亮控制項的不透明品牌主題色。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
