    "The deletion request could not be accepted. Verify your identity and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除リクエストを受け付けられませんでした。本人確認後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 요청을 수락할 수 없습니다. 본인 확인 후 다시 시도하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法接受刪除要求。請驗證身分後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法接受删除请求。请验证身份后重试。"
