    "Your session expired. Sign in again to continue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。もう一度ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. 다시 로그인해 주세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
