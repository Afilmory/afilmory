          "stringUnit": {
            "state": "translated",
            "value": "選擇用於高亮控制項的不透明品牌主題色。"
          }
        }
      }
    },
    "Choose photos from the system library to add them to your gallery.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの写真ライブラリから写真を選び、ギャラリーに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 사진 보관함에서 사진을 선택하여 갤러리에 추가하세요."
