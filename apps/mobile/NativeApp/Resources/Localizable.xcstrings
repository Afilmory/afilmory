    "Add location information to photos to see them on this map.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に位置情報を追加すると、この地図に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 위치 정보를 추가하면 이 지도에서 볼 수 있습니다."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為相片加入位置資訊後，即可在此地圖中查看。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为照片添加位置信息后，即可在此地图中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為照片加入位置資訊後，即可在此地圖中查看。"
          }
        }
      }
    },
