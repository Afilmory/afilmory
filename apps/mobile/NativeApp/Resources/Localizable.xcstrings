        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法接受刪除要求。請驗證身分後再試一次。"
          }
        }
      }
    },
    "The gallery could not be loaded. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリーを読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
