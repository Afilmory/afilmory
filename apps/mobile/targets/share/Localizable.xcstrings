{
  "sourceLanguage": "en",
  "strings": {
    "%lld items": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項"
          }
        }
      }
    },
    "Add a tag, comma separated": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを追加（カンマ区切り）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 추가, 쉼표로 구분"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新增標籤，逗號分隔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加标签，逗号分隔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增標籤，逗號分隔"
          }
        }
      }
    },
    "Adding to upload queue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードキューに追加中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 대기열에 추가 중"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加入上載佇列"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加入上传队列"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加入上傳佇列"
          }
        }
      }
    },
    "Afilmory did not confirm the upload queue. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードキューを確認できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory가 업로드 대기열을 확인하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 未能確認上載佇列，請再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 未能确认上传队列，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 未能確認上傳佇列，請再試。"
          }
        }
      }
    },
    "Afilmory is not ready": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory の準備ができていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory가 준비되지 않았습니다"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 尚未準備好"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 尚未准备好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory 尚未準備好"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Loading shared photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された写真を読み込んでいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유한 사진을 불러오는 중"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入分享的相片"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在载入分享的照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入分享的照片"
          }
        }
      }
    },
    "No images to upload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードする画像がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드할 이미지가 없습니다"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可上載的圖片"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可上传的图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可上傳的圖片"
          }
        }
      }
    },
    "Open Afilmory, sign in, and select a workspace before sharing photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory を開いてサインインし、ワークスペースを選択してから共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Afilmory를 열어 로그인하고 워크스페이스를 선택한 후 사진을 공유하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟 Afilmory、登入並選擇工作區，然後再分享相片。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开 Afilmory、登录并选择工作区，然后再分享照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟 Afilmory、登入並選擇工作區，然後再分享照片。"
          }
        }
      }
    },
    "Preparing %lld of %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 件を準備中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 준비 중"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備第 %1$lld/%2$lld 項"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备第 %1$lld/%2$lld 项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備第 %1$lld/%2$lld 項"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Review Upload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードの確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 확인"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確認上載"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認上傳"
          }
        }
      }
    },
    "Share one or more supported images and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する画像を1枚以上共有して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 이미지를 하나 이상 공유한 후 다시 시도하세요."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一張或多張支援的圖片後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一张或多张受支持的图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一張或多張支援的圖片後再試。"
          }
        }
      }
    },
    "TAGS — THESE BECOME THE FOLDER": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグ — 保存先フォルダになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 — 저장 폴더가 됩니다"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤 —— 決定存放目錄"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签 —— 决定存放目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤 —— 決定存放目錄"
          }
        }
      }
    },
