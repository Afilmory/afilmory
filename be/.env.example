
PORT=1841
DATABASE_URL=postgres://localhost:5432/afilmory
PG_CONN_TIMEOUT=
PG_POOL_MAX=
PG_IDLE_TIMEOUT=
REDIS_URL=localhost:6379
CONFIG_ENCRYPTION_KEY=e77d740f107f7bf618cb3918a49b69ed5abfce2751a0e87925a3e72e2f986dc8

# Cloudflare for SaaS custom hostnames. The API token requires the
# "SSL and Certificates Write" permission for the configured zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_TARGET=customers.afilmory.art

# Sign in with Apple. Team, key, bundle, and optional Services ID can also be
# configured as non-secret system settings. Keep the private key in deployment
# secrets and encode PEM line breaks as \n when multiline values are unsupported.
APPLE_APP_BUNDLE_ID=app.afilmory
APPLE_WEB_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App Store Server verification for auto-renewable subscriptions. This key is
# separate from Sign in with Apple. Provide a JSON array of base64-encoded DER
# Apple root certificates, or a PEM bundle containing one or more certificates.
APP_STORE_BUNDLE_ID=app.afilmory
APP_STORE_APPLE_ID=
APP_STORE_ROOT_CA_CERTIFICATES=
APP_STORE_ENABLE_ONLINE_CHECKS=true

# Browser-only BYO storage setup. The production fallback is
# https://<base-domain>/platform/; local development falls back to Vite :5173.
MOBILE_STORAGE_HANDOFF_WEB_ORIGIN=
MOBILE_STORAGE_HANDOFF_RETURN_URL=afilmory://onboarding/storage

# Apple Push Notification service (token-based authentication)
APNS_TEAM_ID=
APNS_KEY_ID=
# Keep the PEM on one line and encode line breaks as \n.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.afilmory
